{
  "name": "modus-signal",
  "version": "1.0.0",
  "private": true,
  "description": "Модус Сигнал — MVP системы обратной связи и предложений сотрудников ГК «Модус Трейд» (хакатон)",
  "main": "server/index.js",
  "scripts": {
    "start": "npm run build && node server/index.js",
