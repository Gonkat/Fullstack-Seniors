# Необязательные переменные окружения.
# Скопируйте в .env и заполните своими значениями.
# В демо-режиме Mokky эти переменные не нужны.

# Серверный режим: порт Express и каталог JSON-хранилища
PORT=3000
DATA_DIR=./data

# Переопределение проекта Mokky для наполнения демо-данными
MOKKY_BASE_URL=https://your-project.mokky.dev
MOKKY_COLLECTION=test
